def add(a, b):
    return a + b

def sub(a, b):
    return a - b

def mul(a, b):
    return a * b

def div(a, b):
    return a / b


# Input
num1 = int(input("Enter first number: "))
num2 = int(input("Enter second number: "))
op = input("Enter operator (+, -, *, /): ")

# Operation
if op == "+":
    print(add(num1, num2))
elif op == "-":
    print(sub(num1, num2))
elif op == "*":
    print(mul(num1, num2))
elif op == "/":
    print(div(num1, num2))
else:
    print("Invalid operator")
